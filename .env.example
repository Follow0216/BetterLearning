# BetterLearning 服务端环境变量示例。
# 本文件可以提交；真实配置请保存到不入库的 .env.local，或由部署环境注入。
# 根目录 start-server.sh 会在本地按需加载 .env.local，并作为进程环境导出。
# 下列地址与非敏感值仅供本地开发参考，不表示数据库或 Redis 已创建。

# HTTP 服务
SERVER_PORT=8080

# PostgreSQL：密码必填，无内置默认值；留空时应用启动失败。
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/betterlearning
SPRING_DATASOURCE_USERNAME=betterlearning
SPRING_DATASOURCE_PASSWORD=

# Redis：用户名、密码按实际实例配置；未启用认证的本地实例可留空。
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=

# JWT：密钥必填，无内置默认值；使用至少 32 字节安全随机值的 Base64 编码。
# 令牌有效期默认 2 小时，到期后不自动续期，需重新登录。
APP_JWT_SECRET_BASE64=
APP_JWT_ISSUER=betterlearning-server
APP_JWT_AUDIENCE=betterlearning-api
APP_JWT_ACCESS_TOKEN_TTL=PT2H

# Web 跨域来源：逗号分隔的精确 origin，不支持 *、通配符或路径。
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Swagger UI 与 OpenAPI 文档共用开关，未设置时默认关闭；本地示例开启。
APP_DOCS_ENABLED=true

# 注册/登录限流：登录按来源 IP 与规范化用户名分别计数，两项均须通过。
APP_AUTH_LOGIN_IP_LIMIT=30
APP_AUTH_LOGIN_USERNAME_LIMIT=10
APP_AUTH_LOGIN_WINDOW=PT1M
APP_AUTH_REGISTRATION_IP_LIMIT=10
APP_AUTH_REGISTRATION_WINDOW=PT1H

# ---------------------------------------------------------------------------
# dev profile（可选；启用后必须提供账号变量）
# ---------------------------------------------------------------------------
# 仅当显式设置 SPRING_PROFILES_ACTIVE=dev 时才会加载 application-dev.properties，
# 并由 DevUserAccountInitializer 确保一个普通 USER 业务账号存在；
# 默认启动不带 profile，不初始化任何账号。示例（在 server/ 目录下运行）：
#   cd server
#   SPRING_PROFILES_ACTIVE=dev ../start-server.sh
#
# 用户名去首尾空白并转小写，要求 3~32 个字符，仅中文、ASCII 字母、数字和下划线；
# 密码不 trim，要求 8~64 个字符、不能全为空白，且 UTF-8 编码不超过 72 字节。
# 变量按原始字面值读取，密码中的 ${...} 不解析、不替换。
# 同名账号已存在且为 USER、密码匹配时保持不变；密码不同或角色非 USER 时启动失败。
# 请由本地环境注入，真实值不要写入本文件。
# 注意：SPRING_SECURITY_* 仍可能被框架属性绑定读取，但账号初始化只从原始环境变量
# 读取字面值，且只在 dev 执行。
SPRING_SECURITY_USER_NAME=
SPRING_SECURITY_USER_PASSWORD=

# dev 管理员：仅 dev 自动启用，默认 admin / admin123，可覆盖或显式关闭。
# 普通 dev USER 仍需上面两个变量，且用户名必须与管理员不同。
# 已有 USER 不提权；已有 ADMIN 密码不匹配时失败，不重置。
# APP_DEV_ADMIN_ENABLED=false
# APP_DEV_ADMIN_USERNAME=admin
# APP_DEV_ADMIN_PASSWORD=admin123
