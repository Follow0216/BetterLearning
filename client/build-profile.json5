{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "phone",
      "srcPath": "./apps/phone",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "tablet",
      "srcPath": "./apps/tablet",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "common",
      "srcPath": "./common",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    }
  ]
}